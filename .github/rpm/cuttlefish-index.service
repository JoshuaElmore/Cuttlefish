[Unit]
Description=Cuttlefish Filesystem Indexer
After=network.target
# Automatically trigger the aggregator on successful completion
OnSuccess=cuttlefish-aggregate.service

[Service]
Type=oneshot
# Indexing typically requires root to read all filesystem paths
User=root
WorkingDirectory=/etc/cuttlefish
# root_path and threads are read from the `indexer` section of fs_config.yml
ExecStart=/usr/bin/fs_indexer
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cuttlefish-index
